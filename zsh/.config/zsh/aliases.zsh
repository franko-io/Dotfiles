# Eza
alias ll='eza --all --color=always --icons=always --long'
alias ls='eza --color=always --no-filesize --icons=always --no-time --no-user --no-permissions'
alias lt='eza --color=always --icons=always --tree'
alias lth='eza --all --ignore-glob ".git" --color=always --icons=always --tree'

# Clear
alias clear='echo "Do not use clear, use Ctrl+L instead"'

# Navigation
alias -- -='cd -'

# Re-source zsh
alias reload='source $XDG_CONFIG_HOME/zsh/.zshrc'

